{
  "name": "quote-app",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "preview": "vite preview",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint .",
    "test": "vitest run",
    "gate": "npm run typecheck && npm run lint && npm run written && npm run voids && npm run test && npm run build",
    "ui:build": "vite build --config tools/ui-check/vite.config.ts",
    "ui:check": "npm run ui:build --silent && node tools/ui-check/measure.mjs",
    "pdf:proof": "vite build -c tools/pdf-proof/vite.config.ts && node tools/pdf-proof/shot.mjs",
    "written": "node tools/written/check.mjs",
    "voids": "node tools/void/check.mjs"
  },
  "dependencies": {
    "@pdf-lib/fontkit": "^1.1.1",
    "@supabase/supabase-js": "^2.58.0",
    "pdf-lib": "^1.17.1",
    "react": "^19.2.0",
    "react-dom": "^19.2.0"
  },
  "devDependencies": {
    "@eslint/js": "^9.39.0",
    "@types/node": "^22.18.0",
    "@types/react": "^19.2.0",
    "@types/react-dom": "^19.2.0",
    "@vitejs/plugin-react": "^5.0.0",
    "eslint": "^9.39.0",
    "globals": "^16.5.0",
    "playwright": "^1.62.1",
    "typescript": "~5.9.0",
    "typescript-eslint": "^8.46.0",
    "vite": "^7.1.0",
    "vitest": "^3.2.0"
  }
}
